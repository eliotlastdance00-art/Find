    website: "https://github.com/eliotlastdance00-art"
version: 0.1.0
date-released: "2026-11-22"
license: MIT
repository-code: "https://github.com/eliotlastdance00-art/Find"
keywords:
  - deepfake detection
  - audio anti-spoofing
  - media forensics
  - explainable AI
  - Grad-CAM
  - EfficientNet
  - AASIST
