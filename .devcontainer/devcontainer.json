// GitHub Codespaces / Dev Containers: opens the repository with the application installed and
// running on port 8000. Everything happens in scripts/codespace.sh so it can be run by hand too.
{
  "name": "Deepfake Detektor",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.13-bookworm",

  // 2 cores is the smallest machine; the application needs about 1.2 GB of memory.
  "hostRequirements": { "cpus": 2 },

  // The GitHub CLI is what lets the start script open the port to visitors without a GitHub
  // login. Set DFD_PUBLIC_PORT to "false" to keep the address private to the owner.
  "features": { "ghcr.io/devcontainers/features/github-cli:1": {} },
  // DFD_AUTO_UPDATE: each start runs `git pull` first, so a stop + start deploys the newest push.
  "containerEnv": { "DFD_PUBLIC_PORT": "true", "DFD_AUTO_UPDATE": "true" },

  "postCreateCommand": "bash scripts/codespace.sh setup",
  "postStartCommand": "bash scripts/codespace.sh start",
  "postAttachCommand": "bash scripts/codespace.sh info",

  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": { "label": "Deepfake Detektor", "onAutoForward": "openBrowser" }
  },

  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "charliermarsh.ruff"],
      "settings": { "python.defaultInterpreterPath": "${containerWorkspaceFolder}/.venv/bin/python" }
    }
  }
}
