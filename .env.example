# Copy to .env and adjust. Every setting is optional; the defaults work out of the box.

# First administrator, created at start-up if the account does not exist yet.
# Without it, the first account registered in the browser becomes the administrator.
DFD_ADMIN_USERNAME=
DFD_ADMIN_PASSWORD=

# Allow self-registration on the login page (true/false).
DFD_ALLOW_REGISTRATION=true

# Signing key for sessions. Empty = generated once and stored in the data volume.
DFD_SECRET_KEY=
DFD_TOKEN_TTL_HOURS=12

# Limits
DFD_MAX_UPLOAD_MB=200
DFD_MAX_DURATION_S=600

# Analysis
DFD_VIDEO_FRAMES=24          # frames sampled from a video
DFD_EXPLAIN_TOP_K=6          # heatmaps kept per scan
DFD_MAX_FACES=4              # faces analysed in one picture
DFD_ANALYZE_VIDEO_AUDIO=true
DFD_DEVICE=auto              # auto | cpu | cuda
DFD_TORCH_THREADS=0          # 0 = PyTorch default
DFD_WORKERS=1                # scans processed in parallel
DFD_PRELOAD_MODELS=false     # load models at start-up instead of on first scan

# Logging
DFD_LOG_LEVEL=INFO
DFD_LOG_JSON=false           # true in production: one JSON object per line

# Host port published by docker compose
DFD_PORT=8000
